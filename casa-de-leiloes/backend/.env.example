# Banco PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/leiloes?schema=public"
# Porta HTTP da API
PORT=3001
# Segredo do JWT (≥ 16 caracteres; com NODE_ENV=production a API não sobe com valor de exemplo)
JWT_SECRET="troque-este-segredo"
# Segredo da auditoria: gera a chave Ed25519 que assina a cadeia de lances
# e o HMAC dos pseudônimos. NÃO fica no banco. Use um valor longo e aleatório.
AUDIT_SECRET="troque-este-segredo-de-auditoria"
# Origem(ns) do front-end permitidas no CORS, separadas por vírgula
CORS_ORIGIN="http://localhost:3000"
# URL pública do front (usada nos links de compartilhamento do comprovante)
FRONTEND_URL="http://localhost:3000"
# API pública de obras de arte (Art Institute of Chicago)
ARTWORKS_API_URL="https://api.artic.edu/api/v1"
